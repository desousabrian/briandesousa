---
const assetPath = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;

const facts = [
  { k: 'Based', v: 'New York, NY' },
  { k: 'Hometown', v: 'Holmdel, NJ' },
  {
    k: 'Focus',
    v: 'Data Analytics · AI Transformation<br />Business Intelligence · Creative Strategy',
  },
  {
    k: 'Tools',
    v: '',
  },
  { k: 'Age', v: '27' },
];

const tools = [
  'SQL',
  'Python',
  'JavaScript',
  'DOMO',
  'Power BI',
  'Adobe Analytics',
  'Snowflake',
  'Microsoft Azure',
  'Power Automate',
  'Claude',
  'Copilot',
];

const topMovies = [
  { src: '/punchdrunklove.jpg', alt: 'Punch-Drunk Love', hint: 'Punch Drunk Love' },
  { src: '/2001aspaceodyssey.jpg', alt: '2001: A Space Odyssey', hint: '2001: A Space Odyssey' },
  { src: '/brazil.jpg', alt: 'Brazil', hint: 'Brazil' },
  { src: '/reservoirdogs.jpg', alt: 'Reservoir Dogs', hint: 'Reservoir Dogs' },
];

const favoriteAlbums = [
  { src: '/frankocean.jpeg', alt: 'Frank Ocean album cover', hint: 'Blonde' },
  { src: '/thevoidz.png', alt: 'The Voidz album cover', hint: 'Virtue' },
  { src: '/steelydan.jpg', alt: 'Steely Dan album cover', hint: "Can't Buy A Thrill" },
  { src: '/daftpunk.png', alt: 'Daft Punk album cover', hint: 'Discovery' },
];
---

<section class="section profile" id="about">
  <div class="shell">
    <div class="eyebrow scroll-heading" data-scroll-heading>
      <span class="label label--ink scroll-heading__label" data-scroll-heading-label>About</span>
      <span class="rule"></span>
    </div>

    <div class="profile__grid">
      <div class="profile__lead">
        <dl class="profile__facts profile__facts--lead rise" data-delay="1">
          {
            facts.map((f) => (
              <div
                class:list={[
                  'profile__fact',
                  f.k === 'Tools' && 'profile__fact--tools',
                ]}
              >
                <dt class="label">{f.k}</dt>
                {
                  f.k === 'Tools' ? (
                    <dd class="data" data-tools-list>
                      {tools.map((tool) => (
                        <span class="profile__tools-item">
                          {tool !== 'SQL' && tool !== 'Snowflake' && (
                            <span class="profile__tools-separator" aria-hidden="true">·</span>
                          )}
                          {tool}
                        </span>
                      ))}
                    </dd>
                  ) : (
                    <dd class="data" set:html={f.v} />
                  )
                }
              </div>
            ))
          }
        </dl>
        <div class="profile__favorites">
          <div class="profile__favorite rise" data-delay="3">
            <span class="label profile__favorites-label">Top Movies</span>
            <div class="profile__posters" role="list" aria-label="Favorite movies">
              {
                topMovies.map((movie, index) => (
                  <figure class="profile__movie" role="listitem" tabindex="0">
                    <span class="profile__poster-frame">
                      <img
                        class:list={[
                          'profile__poster',
                          index === 0 && 'profile__poster--punch-drunk-love',
                        ]}
                        src={assetPath(movie.src)}
                        alt={movie.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <figcaption class="profile__favorite-hint">{movie.hint}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
          <div class="profile__favorite rise" data-delay="4">
            <span class="label profile__favorites-label">Favorite Albums</span>
            <div class="profile__albums" role="list" aria-label="Favorite albums">
              {
                favoriteAlbums.map((album, index) => (
                  <figure class="profile__album-item" role="listitem" tabindex="0">
                    <span class="profile__album-frame">
                      <img
                        class:list={[
                          'profile__album',
                          index === 0 && 'profile__album--frank-ocean',
                        ]}
                        src={assetPath(album.src)}
                        alt={album.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                    <figcaption class="profile__favorite-hint">{album.hint}</figcaption>
                  </figure>
                ))
              }
            </div>
          </div>
        </div>
        <p class="profile__body rise" data-delay="1">
          My name’s Brian DeSousa! I was born and raised in New Jersey by two
          great parents who immigrated from Portugal. They instilled a curiosity
          in me for all kinds of things, but particularly computers &amp;
          markets, from a young age.
        </p>
        <p class="profile__body rise" data-delay="2">
          I graduated from <strong style="color: #B31B1B;">Cornell University</strong> with a <strong>B.A. in Economics</strong>, minoring in Information Science; while there, I also gained a passion for music
          production &amp; composition. In the years since college I’ve worked at the intersection
          of data, marketing, and AI with Fortune-500 corporations like <strong style="color: #A80023;">Marriott</strong>
          &amp; <strong style="color: #002677;">UnitedHealth Group</strong>.
        </p>
      </div>

      <aside class="profile__aside" aria-label="At a glance">
        <div class="profile__portrait rise" data-delay="1">
          <img class="profile__portrait-img profile__slide" src={assetPath('/brian1.JPG')} alt="Brian DeSousa" loading="lazy" decoding="async" data-slide="0" />
          <img class="profile__portrait-img profile__slide" src={assetPath('/brian2.JPG')} alt="Brian DeSousa" loading="lazy" decoding="async" data-slide="1" />
          <img class="profile__portrait-img profile__slide" src={assetPath('/brian4.JPG')} alt="Brian DeSousa" loading="lazy" decoding="async" data-slide="2" />
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* match the hero's reveal cadence so the next eyebrow peeks into view */
  .profile {
    min-height: calc(100svh - 4rem - clamp(5.5rem, 5.6vw, 6.6rem));
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: clamp(1.25rem, 2vw, 2rem);
    padding-bottom: clamp(2rem, 3.5vw, 3.25rem);
  }

  .profile__grid {
    display: grid;
    /* portrait on the left (narrower), facts/text on the right (wider) */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 6vw, 6rem);
    /* columns share a height so the portrait can be capped to the text */
    align-items: stretch;
  }

  .profile__aside {
    order: -1;
  }

  .profile__lead {
    display: flex;
    flex-direction: column;
  }

  .profile__statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 110%;
    font-variation-settings: 'wght' 600, 'wdth' 110;
    font-size: clamp(1.6rem, 3.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 20ch;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .profile__statement em {
    font-style: normal;
    color: var(--color-signal);
  }

  .profile__body {
    font-family: var(--font-copy);
    max-width: 38rem;
    font-size: clamp(0.97rem, 1.04vw, 1.08rem);
    color: var(--color-ink-2);
    margin-top: 0.85rem;
  }

  .profile__aside {
    /* stretched to the row height (= right column) so the portrait can fill it */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .profile__portrait {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .profile__portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile__slide {
    opacity: 0;
    transition: opacity 1s ease;
  }
  .profile__slide[data-active] {
    opacity: 1;
  }

  .profile__facts {
    display: flex;
    flex-direction: column;
  }
  .profile__fact {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.72rem;
    border-top: 1px solid var(--color-hair);
  }
  .profile__fact:last-child {
    border-bottom: none;
  }
  .profile__fact dd {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0;
    text-align: right;
    color: var(--color-ink);
  }
  .profile__fact--tools dd {
    margin-left: clamp(1rem, 2vw, 1.5rem);
  }
  .profile__tools-item {
    display: inline-block;
    white-space: nowrap;
  }
  .profile__tools-separator {
    display: inline-block;
    margin-inline: 0.3em;
  }

  /* facts shown in the wide left column (in place of the old statement) */
  .profile__facts--lead {
    max-width: 38rem;
    margin-bottom: clamp(0.75rem, 1.4vw, 1.1rem);
  }
  /* no rule above the first fact (Based) */
  .profile__facts--lead .profile__fact:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .profile__favorites {
    order: 3;
    align-self: flex-start;
    display: flex;
    flex-direction: row;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(0.85rem, 1.5vw, 1.25rem);
  }
  .profile__favorite {
    display: flex;
    flex-direction: column;
    gap: clamp(0.65rem, 1.1vw, 0.85rem);
  }
  .profile__posters {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.35rem, 0.55vw, 0.5rem);
  }
  .profile__albums {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.35rem, 0.55vw, 0.5rem);
  }
  .profile__album-item {
    position: relative;
    margin: 0;
    z-index: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .profile__album-frame {
    display: block;
    width: clamp(3.45rem, 5vw, 4.6rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-hair);
    border-radius: 2px;
    box-shadow: 0 0.2rem 0.6rem rgb(20 18 14 / 0.12);
  }
  .profile__album {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile__album--frank-ocean {
    transform: scale(1.08);
  }
  .profile__movie {
    position: relative;
    width: clamp(2.3rem, 3.35vw, 3.05rem);
    margin: 0;
    z-index: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .profile__poster-frame {
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--color-hair);
    border-radius: 2px;
    box-shadow: 0 0.2rem 0.6rem rgb(20 18 14 / 0.12);
  }
  .profile__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile__poster--punch-drunk-love {
    transform: scale(1.04);
  }
  .profile__favorite-hint {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 50%;
    width: max-content;
    max-width: 12rem;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-hair-strong);
    border-radius: 2px;
    background: var(--color-paper);
    box-shadow: 0 0.2rem 0.65rem rgb(20 18 14 / 0.12);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 0.58rem;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.2rem);
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .profile__movie:hover,
  .profile__movie:focus-visible,
  .profile__album-item:hover,
  .profile__album-item:focus-visible {
    z-index: 2;
    outline: none;
    transform: translateY(-0.15rem);
  }
  .profile__movie:hover .profile__favorite-hint,
  .profile__movie:focus-visible .profile__favorite-hint,
  .profile__album-item:hover .profile__favorite-hint,
  .profile__album-item:focus-visible .profile__favorite-hint {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .profile__movie:focus-visible .profile__poster-frame {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .profile__album-item:focus-visible .profile__album-frame {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .profile__movie,
    .profile__album-item,
    .profile__favorite-hint {
      transition: none;
    }
  }

  /* Keep the section on the same viewport rhythm as the hero on shorter
     desktop screens. The favorites occupy the lower portrait column instead
     of adding a second full-width row beneath the profile. */
  @media (min-width: 821px) and (max-height: 899px) {
    .profile {
      padding-bottom: 0;
    }
    .profile > .shell > .eyebrow {
      margin-bottom: 1.1rem;
    }
    .profile__lead {
      position: relative;
      padding-bottom: clamp(6.2rem, calc(22.8svh - 4.06rem), 8.15rem);
    }
    .profile__fact {
      padding-block: 0.54rem;
    }
    .profile__facts--lead {
      margin-bottom: 0.7rem;
    }
    .profile__body {
      margin-top: 0.6rem;
    }
    .profile__favorites {
      position: absolute;
      left: 0;
      bottom: 0;
      padding-top: 0.75rem;
    }
    .profile__favorite {
      gap: 0.5rem;
    }
    .profile__movie {
      width: clamp(
        2rem,
        min(calc(12.5svh - 3.65rem), 3.35vw),
        3.05rem
      );
    }
    .profile__album-frame {
      width: clamp(
        3rem,
        min(calc(18.75svh - 5.45rem), 5vw),
        4.6rem
      );
    }
  }

  @media (max-width: 820px) {
    .profile {
      padding-top: clamp(1.25rem, 2vw, 2rem);
      padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    }
    .profile__grid {
      grid-template-columns: 1fr;
    }
    .profile__lead {
      display: flex;
      flex-direction: column;
    }
    .profile__aside {
      position: static;
    }
    .profile__portrait {
      position: relative;
      width: min(100%, 20rem);
      aspect-ratio: 4 / 5;
      margin-inline: auto;
    }
    .profile__body {
      font-size: 1rem;
    }
    .profile__fact {
      padding-block: 0.85rem;
    }
    .profile__fact dd {
      font-size: 0.82rem;
    }
    .profile__fact--tools dd {
      margin-left: 2rem;
    }
    .profile__movie {
      width: clamp(2.35rem, 10.5vw, 3rem);
    }
    .profile__favorites {
      order: 3;
      align-self: stretch;
      flex-direction: column;
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .profile__album-frame {
      width: clamp(3.5rem, 16vw, 4.5rem);
    }
    .profile__posters,
    .profile__albums {
      gap: 0.3rem;
    }
  }

  @media (max-width: 820px) {
    .profile__favorite-hint {
      inset: auto 0 0;
      width: auto;
      max-width: none;
      padding: 1.2rem 0.25rem 0.25rem;
      border: 0;
      border-radius: 0;
      background: linear-gradient(to bottom, transparent, rgb(14 15 18 / 0.82));
      box-shadow: none;
      color: #fff;
      font-size: 0.5rem;
      line-height: 1.15;
      text-align: center;
      white-space: normal;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>('.profile__slide');
  const profile = document.querySelector<HTMLElement>('.profile');
  let current = 0;
  slides[0]?.setAttribute('data-active', '');

  const startPortraitGallery = () => {
    if (slides.length < 2) return;

    window.setInterval(() => {
      slides[current]?.removeAttribute('data-active');
      current = (current + 1) % slides.length;
      slides[current]?.setAttribute('data-active', '');
    }, 3500);
  };

  if (profile && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;

        startPortraitGallery();
        observer.disconnect();
      },
      {
        // Wait until About reaches the upper 30% of the viewport, so the
        // gallery stays still while only the section heading is peeking in.
        rootMargin: '0px 0px -70% 0px',
      },
    );

    observer.observe(profile);
  } else {
    startPortraitGallery();
  }

</script>
