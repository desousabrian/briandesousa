---
---

<header class="nav">
  <div class="shell nav__inner">
    <a href="#top" class="nav__mark" aria-label="Brian DeSousa — home">
      <span class="nav__glyph">brian desousa</span>
    </a>

    <button
      class="nav__toggle"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav__toggle-bars" aria-hidden="true"></span>
    </button>

    <nav class="nav__menu" id="nav-menu" aria-label="Primary">
      <ul class="nav__list">
        <li class="nav__item">
          <a href="#about" class="nav__link">about</a>
        </li>
        <li class="nav__item">
          <a href="#work" class="nav__link">experience</a>
        </li>
        <li class="nav__item">
          <a href="#projects" class="nav__link">projects</a>
        </li>
        <li class="nav__item">
          <a href="#contact" class="nav__link">contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 85%, transparent);
    backdrop-filter: blur(14px) saturate(1.1);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    /* no separator on load — it appears once you start scrolling */
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  :global(body.scrolled) .nav {
    border-bottom-color: var(--color-hair);
    box-shadow: 0 10px 26px -24px rgba(14, 15, 18, 0.45);
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: clamp(5.5rem, 5.6vw, 6.6rem);
  }

  .nav__mark {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .nav__glyph {
    position: relative;
    z-index: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 800;
    font-stretch: 115%;
    font-variation-settings: 'wght' 800, 'wdth' 115;
    font-size: clamp(1.5rem, 1.75vw, 1.9rem);
    letter-spacing: -0.02em;
    color: var(--color-ink);
    transition: color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* a signal-coloured highlighter wipes in behind the wordmark on hover */
  .nav__glyph::before {
    content: '';
    position: absolute;
    inset: -0.05em -0.3em;
    z-index: -1;
    background: var(--color-signal);
    border-radius: 3px;
    transform: scaleX(0) skewX(-9deg);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .nav__mark:hover .nav__glyph {
      color: var(--color-paper);
    }
    .nav__mark:hover .nav__glyph::before {
      transform: scaleX(1) skewX(-9deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__glyph::before {
      transition: none;
    }
  }

  /* ---------- menu + links ---------- */
  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 2.8vw, 3rem);
    list-style: none;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    position: relative;
    padding-block: 0.25rem;
  }

  /* signal underline on the top-level items */
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    height: 2px;
    width: 100%;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current='location']::after,
  .nav__item--has-sub:hover .nav__link--parent::after,
  .nav__item--has-sub:focus-within .nav__link--parent::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__link[aria-current='location']::after {
    transition-delay: 0.2s;
  }

  /* Let a hovered link temporarily take over from the current-section marker. */
  @media (hover: hover) {
    .nav__list:has(.nav__link:hover:not([aria-current='location']))
      .nav__link[aria-current='location']::after {
      transform: scaleX(0);
      transform-origin: right;
      transition-delay: 0s;
    }
  }

  /* ---------- work dropdown ---------- */
  .nav__sub {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(0.4rem);
    min-width: 9.5rem;
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    margin-top: 0.55rem;
    list-style: none;
    background: var(--color-paper);
    border: 1px solid var(--color-hair);
    border-radius: 5px;
    box-shadow: 0 20px 44px -26px rgba(14, 15, 18, 0.55);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* transparent bridge so hover survives the gap to the panel */
  .nav__item--has-sub::after {
    content: '';
    position: absolute;
    left: 0;
    top: 100%;
    width: 100%;
    height: 1rem;
  }

  .nav__item--has-sub:hover .nav__sub,
  .nav__item--has-sub:focus-within .nav__sub {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav__sublink {
    display: block;
    font-family: var(--font-body);
    font-size: 0.86rem;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    padding: 0.5rem 0.7rem;
    border-radius: 3px;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .nav__sublink:hover,
  .nav__sublink:focus-visible {
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
    color: var(--color-signal-ink);
    outline: none;
  }

  /* ---------- hamburger toggle (hidden on desktop) ---------- */
  .nav__toggle {
    display: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-ink);
  }

  .nav__toggle-bars,
  .nav__toggle-bars::before,
  .nav__toggle-bars::after {
    content: '';
    position: absolute;
    left: 50%;
    width: 1.4rem;
    height: 1.6px;
    background: currentColor;
    transform: translateX(-50%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav__toggle-bars {
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .nav__toggle-bars::before {
    top: -6px;
  }
  .nav__toggle-bars::after {
    top: 6px;
  }

  :global(.nav.is-open) .nav__toggle-bars {
    background: transparent;
  }
  :global(.nav.is-open) .nav__toggle-bars::before {
    top: 0;
    transform: translateX(-50%) rotate(45deg);
  }
  :global(.nav.is-open) .nav__toggle-bars::after {
    top: 0;
    transform: translateX(-50%) rotate(-45deg);
  }

  /* ---------- responsive: panel menu ---------- */
  @media (max-width: 780px) {
    .nav__toggle {
      display: inline-flex;
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-hair);
      box-shadow: 0 24px 44px -28px rgba(14, 15, 18, 0.55);
      padding: 0.5rem var(--gutter) 1.75rem;
      transform: translateY(-0.75rem);
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 0.3s ease,
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.nav.is-open) .nav__menu {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .nav__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      width: 100%;
    }

    .nav__item {
      width: 100%;
      border-bottom: 1px solid var(--color-hair);
    }
    .nav__item:last-child {
      border-bottom: 0;
    }

    .nav__link {
      font-size: 1.15rem;
      padding-block: 0.9rem;
    }
    .nav__link::after {
      bottom: 0.45rem;
      width: 2.75rem;
    }

    /* dropdown expands inline in the panel */
    .nav__sub {
      position: static;
      transform: none;
      opacity: 1;
      pointer-events: auto;
      min-width: 0;
      margin: -0.25rem 0 0.9rem;
      padding: 0 0 0 1rem;
      background: transparent;
      border: 0;
      border-left: 2px solid var(--color-hair-strong);
      border-radius: 0;
      box-shadow: none;
    }
    .nav__sublink {
      font-size: 1rem;
      padding: 0.5rem 0.6rem;
      color: var(--color-mute);
    }
    .nav__item--has-sub::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__sub,
    .nav__menu,
    .nav__caret,
    .nav__toggle-bars,
    .nav__toggle-bars::before,
    .nav__toggle-bars::after {
      transition: none;
    }
  }

  :global(html.nav-is-navigating) {
    scroll-snap-type: none !important;
  }
</style>

<script>
  // Mobile menu toggle. The desktop dropdown is pure CSS (hover / focus-within).
  const nav = document.querySelector<HTMLElement>('.nav');
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');

  if (nav && toggle) {
    const mobileNavQuery = window.matchMedia('(max-width: 780px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let navigationResetTimer: number | undefined;

    const close = () => {
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Close after choosing a destination.
    const sectionLinks = Array.from(
      nav.querySelectorAll<HTMLAnchorElement>('.nav__link[href^="#"]')
    );
    const trackedSections = sectionLinks
      .map((link) => {
        const id = link.hash.slice(1);
        const section = document.getElementById(id);
        return section ? { id, link, section } : null;
      })
      .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

    const setActiveSection = (id: string | null) => {
      trackedSections.forEach(({ id: sectionId, link }) => {
        const active = sectionId === id;
        link.toggleAttribute('aria-current', active);
        if (active) link.setAttribute('aria-current', 'location');
      });
    };

    sectionLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.hash.slice(1);
        const target = document.getElementById(id);

        close();
        setActiveSection(id);

        if (!mobileNavQuery.matches || !target) return;

        event.preventDefault();
        link.blur();
        document.documentElement.classList.add('nav-is-navigating');
        window.clearTimeout(navigationResetTimer);

        requestAnimationFrame(() => {
          target.scrollIntoView({
            behavior: reducedMotionQuery.matches ? 'auto' : 'smooth',
            block: 'start',
          });
          window.history.replaceState(null, '', link.hash);
        });

        navigationResetTimer = window.setTimeout(() => {
          document.documentElement.classList.remove('nav-is-navigating');
        }, reducedMotionQuery.matches ? 0 : 1400);
      });
    });

    let sectionTicking = false;
    const updateActiveSection = () => {
      const navBottom = nav.getBoundingClientRect().bottom;
      const probe = Math.min(
        window.innerHeight - 1,
        navBottom + Math.max(48, window.innerHeight * 0.18)
      );
      let activeId: string | null = null;

      trackedSections.forEach(({ id, section }) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= probe && rect.bottom > probe) activeId = id;
      });

      if (
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 2
      ) {
        activeId = trackedSections.at(-1)?.id ?? activeId;
      }

      setActiveSection(activeId);
      sectionTicking = false;
    };

    const requestSectionUpdate = () => {
      if (sectionTicking) return;
      sectionTicking = true;
      requestAnimationFrame(updateActiveSection);
    };

    window.addEventListener('scroll', requestSectionUpdate, { passive: true });
    window.addEventListener('resize', requestSectionUpdate, { passive: true });
    requestSectionUpdate();

    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        close();
        toggle.focus();
      }
    });
  }
</script>
